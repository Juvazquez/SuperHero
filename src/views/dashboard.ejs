<!-- dashboard.ejs (versión corregida para usar con layout.ejs) -->
<script>
    function confirmarEliminacion() {
        return confirm("¿Estás seguro de que deseas eliminar este superhéroe?");
    }
</script>

<div class="container mx-auto p-6">
    <h1 class="text-4xl font-bold text-center mb-6">Lista de Superhéroes</h1>
    <div class="flex justify-end mb-4">
        <a href="/api/heroes/agregar" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg">
          + Agregar Superhéroe
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-300 shadow-md rounded-lg">
            <thead class="bg-blue-500 text-white">
                <tr>
                    <th class="py-3 px-4 text-left">Nombre Superhéroe</th>
                    <th class="py-3 px-4 text-left">Nombre Real</th>
                    <th class="py-3 px-4 text-left">Edad</th>
                    <th class="py-3 px-4 text-left">Poderes</th>
                    <th class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% superheroes.forEach(hero => { %>
                    <tr class="border-t border-gray-200 hover:bg-gray-100">
                        <td class="py-3 px-4"><%= hero.nombreSuperHeroe %></td>
                        <td class="py-3 px-4"><%= hero.nombreReal %></td>
                        <td class="py-3 px-4"><%= hero.edad %></td>
                        <td class="py-3 px-4"><%= hero.poderes.join(", ") %></td>
                        <td class="py-3 px-4 flex justify-center space-x-2">
                            <a href="/api/heroes/editar/<%= hero._id %>" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded">Editar</a>
                            <form action="/api/heroes/<%= hero._id %>?_method=DELETE" method="POST" onsubmit="return confirmarEliminacion()">
                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>
